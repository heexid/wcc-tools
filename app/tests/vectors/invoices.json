{
  "$comment": "PG3 parity vectors (PRODUCTION-PLAN P2): PLAN §3 matrix + PRD §2.4 rules 7, 8, 12. Each case builds a booking (package price + items), replays `prior` invoices, then sends `request`. Run against calc.ts, the mock repo and the Supabase RPCs; all three must give the same `expect`.",
  "cases": [
    { "name": "new booking → draft, first DP 40 % → partially_paid", "packagePrice": 10000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 40 } }, "expect": { "amount": 4000000, "status": "partially_paid" } },
    { "name": "first Full → paid", "packagePrice": 3000000, "items": [[500000, 2]], "prior": [],
      "request": { "type": "full" }, "expect": { "amount": 4000000, "status": "paid" } },
    { "name": "DP then Partial then Paid → paid", "packagePrice": 10000000, "items": [], "prior": [
        { "type": "dp", "dp": { "method": "fixed", "value": 3000000 } }, { "type": "partial", "amount": 2000000 } ],
      "request": { "type": "paid" }, "expect": { "amount": 5000000, "status": "paid" } },
    { "name": "Paid with the exact remaining amount", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "paid", "amount": 600000 }, "expect": { "amount": 600000, "status": "paid" } },
    { "name": "Paid with a different amount → amount_mismatch", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "paid", "amount": 500000 }, "expect": { "error": "amount_mismatch" } },
    { "name": "Paid with a fractional amount → amount_mismatch", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "paid", "amount": 600000.5 }, "expect": { "error": "amount_mismatch" } },

    { "name": "DP 0 % → dp_zero", "packagePrice": 5000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 0 } }, "expect": { "error": "dp_zero" } },
    { "name": "DP 100 % = total → paid", "packagePrice": 5000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 100 } }, "expect": { "amount": 5000000, "status": "paid" } },
    { "name": "DP 33.33 % rounds half-up to the Rupiah", "packagePrice": 1000001, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 33.33 } }, "expect": { "amount": 333300, "status": "partially_paid" } },
    { "name": "DP 12.5 % of an odd total (exact .5 → up)", "packagePrice": 4, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 12.5 } }, "expect": { "amount": 1, "status": "partially_paid" } },
    { "name": "DP 33.33 % of 10 (0.333 → down)", "packagePrice": 10, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 33.33 } }, "expect": { "amount": 3, "status": "partially_paid" } },
    { "name": "DP 0.01 % rounds to 0 → dp_zero", "packagePrice": 4999, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 0.01 } }, "expect": { "error": "dp_zero" } },
    { "name": "DP 0.01 % of 5000 rounds .5 up to 1", "packagePrice": 5000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 0.01 } }, "expect": { "amount": 1, "status": "partially_paid" } },
    { "name": "DP 33.333 % (3 decimals) → pct_invalid", "packagePrice": 1000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 33.333 } }, "expect": { "error": "pct_invalid" } },
    { "name": "DP 100.01 % → pct_invalid", "packagePrice": 1000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 100.01 } }, "expect": { "error": "pct_invalid" } },
    { "name": "DP -1 % → pct_invalid", "packagePrice": 1000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": -1 } }, "expect": { "error": "pct_invalid" } },
    { "name": "fixed DP above the total → dp_exceeds_total", "packagePrice": 2000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "fixed", "value": 2000001 } }, "expect": { "error": "dp_exceeds_total" } },
    { "name": "fixed DP equal to the total → paid", "packagePrice": 2000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "fixed", "value": 2000000 } }, "expect": { "amount": 2000000, "status": "paid" } },
    { "name": "fixed DP 0 → dp_zero", "packagePrice": 2000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "fixed", "value": 0 } }, "expect": { "error": "dp_zero" } },
    { "name": "fixed DP negative → amount_not_positive", "packagePrice": 2000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "fixed", "value": -5 } }, "expect": { "error": "amount_not_positive" } },
    { "name": "fixed DP fractional → amount_not_positive", "packagePrice": 2000000, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "fixed", "value": 1000.5 } }, "expect": { "error": "amount_not_positive" } },
    { "name": "DP with no dp → dp_zero", "packagePrice": 2000000, "items": [], "prior": [],
      "request": { "type": "dp" }, "expect": { "error": "dp_zero" } },

    { "name": "Full on a Rp 0 booking → amount_not_positive", "packagePrice": 0, "items": [], "prior": [],
      "request": { "type": "full" }, "expect": { "error": "amount_not_positive" } },
    { "name": "DP on a Rp 0 booking → dp_zero", "packagePrice": 0, "items": [], "prior": [],
      "request": { "type": "dp", "dp": { "method": "percentage", "value": 50 } }, "expect": { "error": "dp_zero" } },

    { "name": "Partial equal to remaining → partial_not_less_than_remaining", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "partial", "amount": 600000 }, "expect": { "error": "partial_not_less_than_remaining" } },
    { "name": "Partial 1 below remaining → partially_paid", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "partial", "amount": 599999 }, "expect": { "amount": 599999, "status": "partially_paid" } },
    { "name": "Partial 0 → amount_not_positive", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "partial", "amount": 0 }, "expect": { "error": "amount_not_positive" } },
    { "name": "Partial with no amount → amount_not_positive", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "partial" }, "expect": { "error": "amount_not_positive" } },
    { "name": "Partial fractional → amount_not_positive", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "partial", "amount": 1000.25 }, "expect": { "error": "amount_not_positive" } },

    { "name": "first invoice cannot be Partial → type_not_allowed", "packagePrice": 1000000, "items": [], "prior": [],
      "request": { "type": "partial", "amount": 100 }, "expect": { "error": "type_not_allowed" } },
    { "name": "first invoice cannot be Paid → type_not_allowed", "packagePrice": 1000000, "items": [], "prior": [],
      "request": { "type": "paid" }, "expect": { "error": "type_not_allowed" } },
    { "name": "second DP → type_not_allowed", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }],
      "request": { "type": "dp", "dp": { "method": "fixed", "value": 100 } }, "expect": { "error": "type_not_allowed" } },
    { "name": "anything after Full → booking_paid", "packagePrice": 1000000, "items": [], "prior": [{ "type": "full" }],
      "request": { "type": "partial", "amount": 1 }, "expect": { "error": "booking_paid" } },
    { "name": "Paid on a canceled booking → booking_canceled", "packagePrice": 1000000, "items": [], "prior": [{ "type": "dp", "dp": { "method": "fixed", "value": 400000 } }], "cancel": true,
      "request": { "type": "paid" }, "expect": { "error": "booking_canceled" } },
    { "name": "first DP on a canceled draft → booking_canceled", "packagePrice": 1000000, "items": [], "prior": [], "cancel": true,
      "request": { "type": "full" }, "expect": { "error": "booking_canceled" } },

    { "name": "max qty 999 counts in the total", "packagePrice": 0, "items": [[1000, 999]], "prior": [],
      "request": { "type": "full" }, "expect": { "amount": 999000, "status": "paid" } },
    { "name": "Paid after an edit increased the total", "packagePrice": 1000000, "items": [], "prior": [{ "type": "full" }], "editItems": [[250000, 2]],
      "request": { "type": "paid" }, "expect": { "amount": 500000, "status": "paid" } }
  ]
}
