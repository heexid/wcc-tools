{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:build": "node scripts/check-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "figma:receiver": "node scripts/figma-receiver.mjs",
    "g1": "node scripts/check-g1.mjs",
    "test": "vitest run",
    "e2e": "playwright test tests/e2e",
    "visual": "playwright test tests/visual",
    "gates": "npm run g1 && npm run test && npm run visual",
    "icons": "node scripts/build-icons.mjs",
    "db:seed": "tsx scripts/gen-seed-sql.ts",
    "db:test": "tsx scripts/db-test.ts",
    "test:parity": "vitest run tests/unit/parity.test.ts && tsx scripts/parity-db.ts && tsx scripts/parity-reads.ts",
    "e2e:supabase": "playwright test -c playwright.supabase.config.ts",
    "test:rls": "tsx scripts/db-test.ts 013_rls_matrix",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "fontkit": "2.0.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-pgtap": "0.0.14",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
